---
import Footer from "@/layouts/Footer.astro";
import GalleryView from "@/layouts/GalleryView.astro";
import Layout from "@/layouts/Layout.astro";
import ProfileView from "@/layouts/ProfileView.astro";
---

<Layout>
    <div class="flex flex-col p-8 lg:flex-row lg:p-12">
        <aside class="pb-8 lg:w-1/4">
            <ProfileView />
        </aside>
        <main class="grid grid-cols-1 gap-8 lg:w-3/4 lg:pl-8">
            <GalleryView />
            <Footer />
        </main>
    </div>
</Layout>
