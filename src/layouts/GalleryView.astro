---
import Card from "@/components/Card.astro";
import GalleryCard from "@/components/GalleryCard.astro";
import { supabase } from "@/lib/supabase";

const { data: files, error } = await supabase.storage.from("images").list();

let images: string[] = [];

if (error) {
    console.error("Error fetching images:", error);
} else {
    images = files
        .map(
            (file) =>
                supabase.storage.from("images").getPublicUrl(file.name).data
                    .publicUrl,
        )
        .reverse();
}
---

<Card>
    <div class="mb-4 border-b pb-2 text-2xl font-semibold leading-tight">
        Gallery
    </div>
    <div class="grid grid-cols-2 gap-4 lg:grid-cols-3 xl:grid-cols-4">
        {images.map((imageUrl) => (
            <div>
                <GalleryCard imgUrl={imageUrl} />
            </div>
        ))}
    </div>
</Card>
